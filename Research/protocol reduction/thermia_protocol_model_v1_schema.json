{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Thermia iTec XTR native DCM formal model",
  "type": "object",
  "required": [
    "model_id",
    "generated",
    "live_state",
    "transport",
    "bootstrap",
    "runtime_pages",
    "selectors",
    "desired_transaction",
    "state_model",
    "ack_policy",
    "invariants",
    "open_questions"
  ],
  "properties": {
    "model_id": {
      "type": "string"
    },
    "generated": {
      "type": "string"
    },
    "bootstrap": {
      "type": "array",
      "minItems": 32,
      "maxItems": 32
    },
    "runtime_pages": {
      "type": "array",
      "minItems": 1
    },
    "selectors": {
      "type": "array",
      "minItems": 1
    },
    "invariants": {
      "type": "array",
      "minItems": 1
    }
  }
}